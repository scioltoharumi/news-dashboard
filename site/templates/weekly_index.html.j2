{# weekly_index.html.j2 — ウィークリー一覧（D-38）
   月単位グルーピング + レンズバッジ + トピックチップ行で、
   何週も積み重なっても探しやすい設計。
#}
{% extends "base.html.j2" %}
{% from "macros/archive_item.html.j2" import archive_item %}

{% block title %}ウィークリー一覧 | News & Research Dashboard{% endblock %}

{% block content %}
<header>
  <div class="date-label">WEEKLY INDEX</div>
  <h1>ウィークリー一覧</h1>
  <div class="meta">過去のウィークリーブリーフィング {{ total_count }}件 ／ ISO 週降順 ／ 月別グルーピング</div>
</header>

{% if items_by_month %}
{% for month_label, month_items in items_by_month %}
<div class="month-section">
  <div class="month-header">{{ month_label }}（{{ month_items | length }} 週）</div>
  <div class="month-items">
    {% for it in month_items %}
    {{ archive_item(it, 'weekly') }}
    {% endfor %}
  </div>
</div>
{% endfor %}
{% else %}
<p style="color: var(--text-mute); padding: 20px; text-align: center;">
  ウィークリーブリーフィングはまだ生成されていません。<br>
  Phase 4 でウィークリー 3 部生成が稼働すると、ここに月別で一覧が表示されます。
</p>
{% endif %}
{% endblock %}
