{# index.html.j2 — 最新デイリー（トップページ） #}
{% extends "base.html.j2" %}
{% from "partials/card.html.j2" import render_card %}
{% from "partials/pulse.html.j2" import today_pulse %}

{% block title %}{{ today_iso }} デイリー | News & Research Dashboard{% endblock %}

{% block content %}
<header>
  <div class="date-label">WEEK {{ iso_week }} DAY {{ iso_dow }} / {{ today_iso }}</div>
  <h1>今日のニュース・ダッシュボード</h1>
  <div class="meta">{{ today_label }} ／ 収録 {{ cards | length }}件</div>
</header>

{% if daily_summary %}
<div class="theme">
  <div class="theme-label">今日のサマリー</div>
  <div class="theme-body">
    {{ daily_summary | safe }}
  </div>
</div>
{% endif %}

{# Today's Pulse — 数値 + トピック分布バー #}
{% if cards %}
{{ today_pulse(stats) }}
{% endif %}

<details class="filter-bar" open>
  <summary>フィルター</summary>
  <div class="filter-group">
    <span class="filter-label">トピック:</span>
    <button class="filter-chip active" data-filter-topic="ai_agents">AIエージェント</button>
    <button class="filter-chip active" data-filter-topic="automation">業務自動化</button>
    <button class="filter-chip active" data-filter-topic="dx_cases">DX事例</button>
    <button class="filter-chip active" data-filter-topic="other">その他</button>
  </div>
  <div class="filter-group">
    <span class="filter-label">重要度:</span>
    <button class="filter-chip active" data-filter-importance="high">高</button>
    <button class="filter-chip active" data-filter-importance="mid">中</button>
    <button class="filter-chip active" data-filter-importance="low">低</button>
    <button class="filter-clear">すべて表示</button>
  </div>
</details>

{# 重要度グルーピング — 高 → 中 → 低 #}
{% if cards %}
  {% set first_done = namespace(value=false) %}
  {% for level, label in [('high','高'), ('mid','中'), ('low','低')] %}
    {% set group = cards | selectattr('importance', 'equalto', level) | list %}
    {% if group %}
    <div class="section-divider importance-{{ level }}">
      <svg class="icon" aria-hidden="true"><use href="#icon-importance-{{ level }}"/></svg>
      <span class="section-divider-label">重要度: {{ label }}</span>
      <span class="section-divider-count">{{ group | length }} 件</span>
    </div>
      {% for card in group %}
        {% if not first_done.value %}
          {{ render_card(card, is_first=true, today_iso=today_iso) }}
          {% set first_done.value = true %}
        {% else %}
          {{ render_card(card, is_first=false, today_iso=today_iso) }}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% else %}
<p style="color: var(--text-mute); padding: 20px; text-align: center;">本日収録のカードはまだありません。</p>
{% endif %}
{% endblock %}
