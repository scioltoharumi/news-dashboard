{# base.html.j2 — 共通レイアウト
   ブロック: title / extra_head / content / footer_extra
   フッタ 3 リンク (D-38): デイリー履歴 / ウィークリー一覧 / 問い一覧
   root_prefix は build_site._compute_root_prefix で算出される (2026-04-26 fix)
#}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}News & Research Dashboard{% endblock %}</title>
<link rel="stylesheet" href="{{ root_prefix }}assets/style.css">
{% block extra_head %}{% endblock %}
</head>
<body>
{# アイコン sprite を全ページで inline 読込（D-40 §11.4）
   icons_sprite は build_site.py が site/assets/icons.svg の中身を渡す #}
{{ icons_sprite | safe }}

<div class="container">
{% block content %}{% endblock %}

<footer>
  <nav class="footer-nav">
    <a href="{{ root_prefix }}daily/archive/">デイリー履歴</a>
    <a href="{{ root_prefix }}weekly/">ウィークリー一覧</a>
    <a href="{{ root_prefix }}inquiries/">問い一覧</a>
  </nav>
  <div>News &amp; Research Dashboard / 自動生成 ({{ generated_at }})</div>
  {% block footer_extra %}{% endblock %}
</footer>

</div>
<script src="{{ root_prefix }}assets/filter.js"></script>
</body>
</html>
